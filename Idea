  /* ---------- compare ---------- */
  function renderCompare() {
    var P = plan(params);
    var t = '<table><thead><tr><th>Term</th><th>Interest per month</th><th>Each installment</th><th>First as % of loan</th><th>Buffer ÷ first</th><th>Sell at first</th><th>Break-even rise</th><th>Rise per month</th></tr></thead><tbody>';
