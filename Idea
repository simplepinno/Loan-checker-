<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Loan Leverage Planner</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
/* Layout: one narrow column, sticky tab bar, verdict first, then inputs, then a ledger of results. */
:root {
  --bg: #F2F5F3;
  --surface: #FFFFFF;
  --field: #E9EFEC;
  --fg: #13211E;
  --muted: #55675F;
  --line: #D3DDD8;
  --accent: #0E6B5B;
  --accent-fg: #FFFFFF;
  --good: #17703F;
  --good-bg: #DCF0E4;
  --warn: #7E5200;
  --warn-bg: #FAEAC6;
  --bad: #A3231B;
  --bad-bg: #F8DAD6;
  --font-body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-label: "IBM Plex Sans Condensed", "Arial Narrow", system-ui, sans-serif;
  --font-num: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0E1614; --surface: #16211E; --field: #1D2B27; --fg: #E4EDEA; --muted: #93A8A1; --line: #2A3B37;
    --accent: #58C4AD; --accent-fg: #06201A; --good: #6FD39B; --good-bg: #16342A; --warn: #E8B64A; --warn-bg: #3A2E10;
    --bad: #F08A80; --bad-bg: #3C1B18; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0E1614; --surface: #16211E; --field: #1D2B27; --fg: #E4EDEA; --muted: #93A8A1; --line: #2A3B37;
  --accent: #58C4AD; --accent-fg: #06201A; --good: #6FD39B; --good-bg: #16342A; --warn: #E8B64A; --warn-bg: #3A2E10;
  --bad: #F08A80; --bad-bg: #3C1B18; color-scheme: dark;
}
* { box-sizing: border-box; }
body {
  background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: 15px; line-height: 1.45;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 18px 56px;
}
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--bg); }
.wrap { max-width: 640px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }
h1 { font-family: var(--font-label); font-weight: 600; font-size: 26px; line-height: 1.1; margin: 0; letter-spacing: 0.01em; text-wrap: balance; }
.sub { color: var(--muted); margin: 4px 0 0; max-width: 52ch; }
h2 { font-family: var(--font-label); font-weight: 600; font-size: 13px; letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
.num { font-family: var(--font-num); font-variant-numeric: tabular-nums; }

nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 11; background: var(--bg); padding: 6px 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; border-bottom: 1px solid var(--line); }
nav button { font: inherit; font-family: var(--font-label); font-weight: 500; font-size: 15px; background: transparent; color: var(--muted); border: 0; border-radius: 6px; padding: 9px 4px; cursor: pointer; }
nav button[aria-current="page"] { background: var(--accent); color: var(--accent-fg); }
nav button:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

.verdict { padding: 16px; border-radius: 8px; display: flex; flex-direction: column; gap: 6px; }
.verdict .tag { font-family: var(--font-label); font-weight: 600; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
.verdict .head { font-family: var(--font-label); font-weight: 600; font-size: 22px; line-height: 1.15; text-wrap: balance; }
.verdict p { margin: 0; }
.v-good { background: var(--good-bg); color: var(--good); }
.v-warn { background: var(--warn-bg); color: var(--warn); }
.v-bad { background: var(--bad-bg); color: var(--bad); }

.group { display: flex; flex-direction: column; gap: 10px; }
.fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
.field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.field label { font-size: 13px; color: var(--muted); }
.inwrap { position: relative; }
.inwrap input { width: 100%; }
.inwrap .suf { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); color: var(--muted); font-family: var(--font-num); pointer-events: none; }
input[type="number"], input[type="date"] { font: inherit; font-family: var(--font-num); font-size: 16px; color: var(--fg); background: var(--field); border: 1px solid var(--line); border-radius: 6px; padding: 9px 10px; min-width: 0; }
input.pct { padding-right: 26px; }
.seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; background: var(--field); border: 1px solid var(--line); border-radius: 6px; padding: 3px; }
.seg button { font: inherit; font-family: var(--font-num); font-size: 14px; background: transparent; color: var(--fg); border: 0; border-radius: 4px; padding: 7px 4px; cursor: pointer; }
.seg button[aria-pressed="true"] { background: var(--accent); color: var(--accent-fg); }
.hint { font-size: 13px; color: var(--muted); margin: 0; }

.split { display: flex; height: 14px; border-radius: 4px; overflow: hidden; background: var(--field); }
.split .inv { background: var(--accent); }
.split .buf { background: var(--muted); }
.legend { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 13px; color: var(--muted); margin-top: 6px; }
.dot { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 6px; vertical-align: baseline; }

.ledger { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
.row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--line); }
.row .k { min-width: 0; }
.row .k small { display: block; color: var(--muted); font-size: 12.5px; }
.row .v { font-family: var(--font-num); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; font-weight: 500; }
.pos { color: var(--good); } .neg { color: var(--bad); } .amb { color: var(--warn); }
.pill { display: inline-block; font-family: var(--font-label); font-weight: 600; font-size: 12.5px; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 9px; border-radius: 99px; }
.p-good { background: var(--good-bg); color: var(--good); }
.p-warn { background: var(--warn-bg); color: var(--warn); }
.p-bad { background: var(--bad-bg); color: var(--bad); }

.sched { display: flex; flex-direction: column; gap: 0; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { font: inherit; font-family: var(--font-num); font-size: 13px; background: var(--field); color: var(--fg); border: 1px solid var(--line); border-radius: 99px; padding: 5px 11px; cursor: pointer; }
.chip[aria-pressed="true"] { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
input[type="range"] { width: 100%; accent-color: var(--accent); }
.bigval { font-family: var(--font-num); font-size: 30px; font-weight: 500; }
.slider-head { display: flex; justify-content: space-between; align-items: baseline; }

svg.chart { width: 100%; height: auto; display: block; }
svg.chart text { font-family: var(--font-num); font-size: 10px; fill: var(--muted); }
.c-line { fill: none; stroke: var(--fg); stroke-width: 1.8; }
.c-zero { stroke: var(--muted); stroke-width: 1; }
.c-grid { stroke: var(--line); stroke-width: 1; }
.c-up { fill: var(--good-bg); } .c-down { fill: var(--bad-bg); }
.m-stop { stroke: var(--bad); stroke-width: 1.2; stroke-dasharray: 4 3; }
.m-be { stroke: var(--good); stroke-width: 1.2; stroke-dasharray: 4 3; }
.m-now { stroke: var(--accent); stroke-width: 1.6; }
.t-stop { fill: var(--bad) !important; } .t-be { fill: var(--good) !important; }
.c-dot { fill: var(--accent); stroke: var(--bg); stroke-width: 2; }

.scroller { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; min-width: 520px; font-size: 13.5px; }
th { font-family: var(--font-label); font-weight: 600; font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); text-align: right; padding: 8px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
th:first-child, td:first-child { text-align: left; }
td { text-align: right; padding: 8px 8px; border-bottom: 1px solid var(--line); font-family: var(--font-num); font-variant-numeric: tabular-nums; white-space: nowrap; }
tr.hl td { background: var(--field); }

.btn { font: inherit; font-family: var(--font-label); font-weight: 600; font-size: 16px; background: var(--accent); color: var(--accent-fg); border: 0; border-radius: 6px; padding: 11px 16px; cursor: pointer; }
.btn.ghost { background: transparent; color: var(--accent); border: 1px solid var(--line); }
.btn.small { font-size: 13px; padding: 5px 10px; }
.entries { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
.entry { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; padding: 10px 0; border-bottom: 1px solid var(--line); align-items: center; }
.entry .meta { color: var(--muted); font-size: 13px; }
.empty { background: var(--field); border-radius: 8px; padding: 14px; color: var(--muted); }
.foot { font-size: 12.5px; color: var(--muted); }
.note { background: var(--field); border-radius: 8px; padding: 10px 12px; font-size: 13.5px; color: var(--muted); }
</style>

<div class="wrap">
  <header>
    <h1>Loan Leverage Planner</h1>
    <p class="sub">Borrow to invest: what it costs, how much to keep as cash, and when to get out. Figures start as an example from your first sketch. Replace them with your own.</p>
  </header>

  <nav aria-label="Sections">
    <button type="button" data-tab="plan">Plan</button>
    <button type="button" data-tab="price-test">Price test</button>
    <button type="button" data-tab="tracker">Tracker</button>
    <button type="button" data-tab="compare">Compare</button>
  </nav>

  <!-- PLAN -->
  <section id="tab-plan" class="wrap" style="gap:20px">
    <div id="verdict"></div>

    <div class="group">
      <h2>Loan</h2>
      <div class="fields">
        <div class="field"><label for="f-loan">Loan amount</label><input id="f-loan" type="number" inputmode="decimal" min="0" step="1000"></div>
        <div class="field"><label for="f-rate">Flat rate for the whole term</label><div class="inwrap"><input id="f-rate" class="pct" type="number" inputmode="decimal" min="0" step="0.5"><span class="suf">%</span></div></div>
        <div class="field"><label id="lbl-term">Term</label>
          <div class="seg" role="group" aria-labelledby="lbl-term">
            <button type="button" id="term-1" data-months="1">1 month</button>
            <button type="button" id="term-2" data-months="2">2 months</button>
            <button type="button" id="term-3" data-months="3">3 months</button>
          </div>
        </div>
        <div class="field"><label for="f-start">Start date</label><input id="f-start" type="date"></div>
      </div>
      <p class="hint">Early repayment saves no interest, so the full amount is owed whenever you repay. Installments are equal, one every 30 days.</p>
    </div>

    <div class="group">
      <h2>Your money</h2>
      <div class="fields">
        <div class="field"><label for="f-own">Own cash put in</label><input id="f-own" type="number" inputmode="decimal" min="0" step="1000"></div>
        <div class="field"><label for="f-buf">Kept as cash buffer</label><div class="inwrap"><input id="f-buf" class="pct" type="number" inputmode="decimal" min="0" max="100" step="1"><span class="suf">%</span></div></div>
      </div>
      <p class="hint">The buffer is a share of loan plus own cash. It is never invested.</p>
    </div>

    <div class="group">
      <h2>Fees</h2>
      <div class="fields">
        <div class="field"><label for="f-buyfee">Buy fee</label><div class="inwrap"><input id="f-buyfee" class="pct" type="number" inputmode="decimal" min="0" step="0.5"><span class="suf">%</span></div></div>
        <div class="field"><label for="f-sellfee">Sell fee</label><div class="inwrap"><input id="f-sellfee" class="pct" type="number" inputmode="decimal" min="0" step="0.5"><span class="suf">%</span></div></div>
      </div>
    </div>

    <div class="group">
      <h2>Exit rules</h2>
      <div class="fields">
        <div class="field"><label for="f-watch">Watch after a fall of</label><div class="inwrap"><input id="f-watch" class="pct" type="number" inputmode="decimal" min="0" step="1"><span class="suf">%</span></div></div>
        <div class="field"><label for="f-stop">Stop-loss at a fall of</label><div class="inwrap"><input id="f-stop" class="pct" type="number" inputmode="decimal" min="0" step="1"><span class="suf">%</span></div></div>
        <div class="field"><label for="f-stress">Stress fall (stop fails)</label><div class="inwrap"><input id="f-stress" class="pct" type="number" inputmode="decimal" min="0" step="1"><span class="suf">%</span></div></div>
        <div class="field"><label for="f-maxloss">Most you can afford to lose</label><input id="f-maxloss" type="number" inputmode="decimal" min="0" step="1000"></div>
      </div>
    </div>

    <div class="group">
      <h2>Your expectation</h2>
      <div class="fields">
        <div class="field"><label for="f-expect">Expected price rise over the term</label><div class="inwrap"><input id="f-expect" class="pct" type="number" inputmode="decimal" step="1"><span class="suf">%</span></div></div>
        <div class="field"><label for="f-haircut">Haircut on your optimism</label><div class="inwrap"><input id="f-haircut" class="pct" type="number" inputmode="decimal" min="0" max="100" step="5"><span class="suf">%</span></div></div>
      </div>
    </div>

    <div class="group">
      <h2>Where the money goes</h2>
      <div id="split"></div>
    </div>

    <div class="group">
      <h2>Key numbers</h2>
      <div id="ledger" class="ledger"></div>
    </div>

    <div class="group">
      <h2>Installments</h2>
      <div id="sched" class="sched"></div>
    </div>

    <div><button type="button" class="btn ghost" id="reset">Reset to example values</button></div>
  </section>

  <!-- PRICE TEST -->
  <section id="tab-price-test" class="wrap" style="gap:20px" hidden>
    <div class="group">
      <h2>If the price moves</h2>
      <div class="slider-head"><span class="bigval" id="m-big">0%</span><span id="m-pill"></span></div>
      <input id="m-slider" type="range" min="-50" max="80" step="1" value="0" aria-label="Price change from entry in percent">
      <div class="chips" id="m-chips"></div>
    </div>
    <div class="group">
      <h2>Result at maturity</h2>
      <div id="m-ledger" class="ledger"></div>
    </div>
    <div class="group">
      <h2>Profit and loss across prices</h2>
      <div id="m-chart"></div>
    </div>
  </section>

  <!-- TRACKER -->
  <section id="tab-tracker" class="wrap" style="gap:20px" hidden>
    <div class="group">
      <h2>Where you stand</h2>
      <div id="t-status"></div>
    </div>
    <div class="group">
      <h2>Log today</h2>
      <div class="fields">
        <div class="field"><label for="t-date">Date</label><input id="t-date" type="date"></div>
        <div class="field"><label for="t-value">Market value of what you hold</label><input id="t-value" type="number" inputmode="decimal" step="100"></div>
        <div class="field"><label for="t-basis">Cost basis of what you hold</label><input id="t-basis" type="number" inputmode="decimal" step="100"></div>
        <div class="field"><label for="t-cash">Cash held</label><input id="t-cash" type="number" inputmode="decimal" step="100"></div>
        <div class="field"><label for="t-paid">Installments paid so far</label><input id="t-paid" type="number" inputmode="numeric" min="0" max="3" step="1"></div>
      </div>
      <p class="hint">If you sell part of the position, lower the cost basis by the same share you sold. Fields start from your last entry.</p>
      <div><button type="button" class="btn" id="t-add">Log entry</button></div>
    </div>
    <div class="group">
      <h2>History</h2>
      <div id="t-list"></div>
    </div>
  </section>

  <!-- COMPARE -->
  <section id="tab-compare" class="wrap" style="gap:20px" hidden>
    <div class="group">
      <h2>1, 2 or 3 months</h2>
      <p class="hint">The same rate from the Plan tab is applied to every term. The break-even price rise does not change with the term, but a longer term gives the price more days to get there.</p>
      <div class="scroller" id="c-terms"></div>
    </div>
    <div class="group">
      <h2>How much own cash</h2>
      <p class="hint">Own cash is invested alongside the loan with the same buffer share. The highlighted row is the amount on the Plan tab.</p>
      <div class="scroller" id="c-own"></div>
    </div>
  </section>

  <p class="foot" id="storage"></p>
</div>

<script>
/*CORE-START*/
var DEFAULTS = { loan: 70000, rate: 16, months: 2, start: '2026-11-06', own: 20000, bufPct: 30, buyFee: 4, sellFee: 4,
  watch: 10, stop: 20, stress: 30, maxLoss: 25000, expect: 25, haircut: 30 };

function plan(p) {
  var L = p.loan, i = p.rate / 100, n = p.months;
  var bf = p.buyFee / 100, sf = p.sellFee / 100, k = (1 - bf) * (1 - sf);
  var O = p.own, b = p.bufPct / 100;
  var interest = L * i, owed = L + interest, inst = owed / n;
  var T = L + O, B = T * b, spend = T - B, basis = spend * (1 - bf);
  var watch = p.watch / 100, stop = p.stop / 100, stress = p.stress / 100;
  var re = (p.expect / 100) * (1 - p.haircut / 100);
  var plAt = function (m) { return B + basis * (1 + m) * (1 - sf) - owed - O; };
  var be = basis > 0 ? (owed + O - B) / ((1 - sf) * basis) - 1 : NaN;
  var hurdle = (1 + i - b) / ((1 - b) * k) - 1;
  var aS = b + (1 - b) * k * (1 - stress);
  var Lmax = Math.max((p.maxLoss - O * (1 - aS)) / (1 + i - aS), 0);
  var gain = b + (1 - b) * k * (1 + re) - 1 - i;
  var plStop = plAt(-stop), plStress = plAt(-stress), plWatch = plAt(-watch);
  return {
    L: L, i: i, n: n, sf: sf, bf: bf, k: k, O: O, b: b, interest: interest, owed: owed, inst: inst, T: T, B: B, spend: spend,
    basis: basis, watch: watch, stop: stop, stress: stress, re: re, plAt: plAt, be: be, hurdle: hurdle, aS: aS, Lmax: Lmax,
    gain: gain, recLoan: gain > 0 ? Lmax : 0, plStop: plStop, plStress: plStress, plWatch: plWatch,
    leftOwing: Math.max(-plStop - O, 0), ownLost: O > 0 ? Math.min(-plStop / O, 1) : null,
    expPL: plAt(re), expOwnOnly: O * (b + (1 - b) * k * (1 + re) - 1),
    feeFloor: 1 / k - 1, rawNeeded: p.haircut < 100 ? hurdle / (1 - p.haircut / 100) : Infinity,
    firstSale: Math.max(inst - B, 0) / (1 - sf), cover: B / inst, day1PL: plAt(0)
  };
}

function dayNum(s) {
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s || '');
  if (!m) return NaN;
  return Math.floor(Date.UTC(+m[1], +m[2] - 1, +m[3]) / 86400000);
}

function entryCalc(e, P, p) {
  var days = p.months * 30;
  var el = Math.min(Math.max(dayNum(e.date) - dayNum(p.start), 0), days);
  if (isNaN(el)) el = 0;
  var paid = e.paid || 0;
  var owedRem = P.owed - paid * P.inst;
  var net = e.value * (1 - P.sf);
  var equity = e.cash + net - owedRem;
  var pl = equity - P.O;
  var ret = e.basis > 0 ? e.value / e.basis - 1 : NaN;
  var needed = e.value > 0 ? (owedRem + P.O - e.cash) / (1 - P.sf) / e.value - 1 : NaN;
  var done = paid >= p.months;
  var nextInst = done ? 0 : P.inst;
  var dueIn = done ? null : (paid + 1) * 30 - el;
  var sale = Math.max(nextInst - e.cash, 0) / (1 - P.sf);
  var shortfall = Math.max(owedRem - e.cash - net, 0);
  var st;
  if (el >= days) st = 'DUE';
  else if (pl >= 0) st = 'PROFIT';
  else if (!isNaN(ret) && ret <= -P.stop) st = 'EXIT';
  else if (!isNaN(ret) && ret <= -P.watch) st = 'WATCH';
  else st = 'HOLD';
  return { el: el, left: days - el, owedRem: owedRem, net: net, equity: equity, pl: pl, ret: ret, needed: needed,
    nextInst: nextInst, dueIn: dueIn, sale: sale, shortfall: shortfall, status: st };
}

function ownRow(pct, p) {
  var L = p.loan, i = p.rate / 100, bf = p.buyFee / 100, sf = p.sellFee / 100;
  var O = pct * L, T = L + O, B = T * p.bufPct / 100, spend = T - B, basis = spend * (1 - bf), owed = L * (1 + i);
  var pl = function (m) { return B + basis * (1 + m) * (1 - sf) - owed - O; };
  var ps = pl(-p.stop / 100);
  return { O: O, T: T, B: B, spend: spend, be: (owed + O - B) / ((1 - sf) * basis) - 1, plStop: ps,
    plStress: pl(-p.stress / 100), left: Math.max(-ps - O, 0), lost: O > 0 ? Math.min(-ps / O, 1) : null,
    cover: B / (owed / p.months) };
}

function termRow(n, p) {
  var L = p.loan, i = p.rate / 100, sf = p.sellFee / 100, bf = p.buyFee / 100;
  var O = p.own, T = L + O, B = T * p.bufPct / 100, basis = (T - B) * (1 - bf), owed = L * (1 + i), inst = owed / n;
  var pl = function (m) { return B + basis * (1 + m) * (1 - sf) - owed - O; };
  var be = (owed + O - B) / ((1 - sf) * basis) - 1;
  return { n: n, inst: inst, firstPct: inst / L, cover: B / inst, sale: Math.max(inst - B, 0) / (1 - sf),
    perMonth: p.rate / 100 / n, be: be, bePerMonth: be / n, plStop: pl(-p.stop / 100) };
}
