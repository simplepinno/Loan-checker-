  function chart(P, mNow) {
    var W = 360, H = 220, ml = 54, mr = 12, mt = 16, mb = 28;
    var x0 = -50, x1 = 80;
    var xs = [], ys = [];
    for (var x = x0; x <= x1; x += 5) { xs.push(x); ys.push(P.plAt(x / 100)); }
    var lo = Math.min.apply(null, ys.concat([0])), hi = Math.max.apply(null, ys.concat([0]));
    var span = hi - lo || 1; lo -= span * 0.06; hi += span * 0.06;
    var sx = function (v) { return ml + (v - x0) / (x1 - x0) * (W - ml - mr); };
    var sy = function (v) { return mt + (hi - v) / (hi - lo) * (H - mt - mb); };
    var pts = xs.map(function (v, i) { return sx(v).toFixed(1) + ',' + sy(ys[i]).toFixed(1); });
    var line = 'M' + pts.join(' L');
    var area = line + ' L' + sx(x1).toFixed(1) + ',' + sy(0).toFixed(1) + ' L' + sx(x0).toFixed(1) + ',' + sy(0).toFixed(1) + ' Z';
    var z = sy(0);
    var svg = '<svg class="chart" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="Net profit or loss at maturity for price changes from minus 50 to plus 80 percent">';
    svg += '<defs><clipPath id="cl-up"><rect x="0" y="0" width="' + W + '" height="' + z.toFixed(1) + '"/></clipPath><clipPath id="cl-dn"><rect x="0" y="' + z.toFixed(1) + '" width="' + W + '" height="' + H + '"/></clipPath></defs>';
    [-40, -20, 0, 20, 40, 60, 80].forEach(function (t) {
      svg += '<line class="c-grid" x1="' + sx(t).toFixed(1) + '" x2="' + sx(t).toFixed(1) + '" y1="' + mt + '" y2="' + (H - mb) + '"/>';
      svg += '<text x="' + sx(t).toFixed(1) + '" y="' + (H - 10) + '" text-anchor="middle">' + (t > 0 ? '+' : (t < 0 ? '−' : '')) + Math.abs(t) + '%</text>';
    });
    var yt = [Math.round(hi / 1000) * 1000, 0, Math.round(lo / 1000) * 1000];
    yt.forEach(function (t) {
      if (t !== 0 && (t > hi || t < lo)) return;
      svg += '<text x="' + (ml - 6) + '" y="' + (sy(t) + 3).toFixed(1) + '" text-anchor="end">' + money(t) + '</text>';
    });
    svg += '<path class="c-up" d="' + area + '" clip-path="url(#cl-up)"/><path class="c-down" d="' + area + '" clip-path="url(#cl-dn)"/>';
    svg += '<line class="c-zero" x1="' + ml + '" x2="' + (W - mr) + '" y1="' + z.toFixed(1) + '" y2="' + z.toFixed(1) + '"/>';
